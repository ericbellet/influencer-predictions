# Official ingest window. Videos published before this date are ignored
# unless INGEST_ALLOW_HISTORICAL=true or the cron is called with ?test=1.
INGEST_SINCE=2026-09-06

# When true, the cron may process older videos (useful for a first test run).
INGEST_ALLOW_HISTORICAL=false

# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Same Supabase Postgres as the professor platform. The cron writes
# processed videos into table influencer_ingest_state.
# Locally you can omit this and the service will use data/state.json.
DATABASE_URL=

# Optional. Used for structured extraction. On Vercel, OIDC + AI Gateway
# is enough and this can stay empty.
# AI_GATEWAY_API_KEY=
